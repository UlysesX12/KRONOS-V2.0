{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "KRONOS: Compilar en Dev Container",
      "problemMatcher": "$msCompile",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "Kronos.sln",
        "-c",
        "Release"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "AVALONIA_TELEMETRY_OPTOUT": "1",
          "DOTNET_CLI_TELEMETRY_OPTOUT": "1"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "KRONOS: Probar en Dev Container",
      "problemMatcher": "$msCompile",
      "command": "sh",
      "type": "process",
      "args": [
        "scripts/test.sh"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "KRONOS: Sincronizar historial inicial con GitHub",
      "problemMatcher": [],
      "command": "python3",
      "type": "process",
      "args": [
        "scripts/sync_git.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    }
  ]
}
